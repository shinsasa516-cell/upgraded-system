import sqlite3
import urllib.request
from bs4 import BeautifulSoup
import os

print("🤖 高度な自動巡回＆デザイン生成エンジンが起動しました...")

# 1. データベースの準備
db_path = "knowledge_hub.db"
conn = sqlite3.connect(db_path)
cursor = conn.cursor()

cursor.execute("""
    CREATE TABLE IF NOT EXISTS scraped_data (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        category TEXT,
        title TEXT
    )
""")
conn.commit()

# 2. 全分野を網羅するマルチジャンル・情報源リスト（必要に応じてここを増やせます）
target_sites = [
    {"category": "テクノロジー", "url": "https://ja.wikipedia.org/wiki/%E3%82%B3%E3%83%B3%E3%83%94%E3%83%A5%E3%83%BC%E3%82%B0"},
    {"category": "サイエンス", "url": "https://ja.wikipedia.org/wiki/%E7%A7%91%E5%AD%A6"},
    {"category": "ビジネス・社会", "url": "https://ja.wikipedia.org/wiki/%E7%B5%8c%E6%B8%88"},
    {"category": "歴史", "url": "https://ja.wikipedia.org/wiki/%E6%AD%B4%E5%8F%B2"},
    {"category": "文化・芸術", "url": "https://ja.wikipedia.org/wiki/%E8%8A%B8%E8%A1%93"}
]

total_saved = 0
headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}

for site in target_sites:
    category = site["category"]
    url = site["url"]
    print(f"👉 【{category}】のページを収集中...")
    
    try:
        req = urllib.request.Request(url, headers=headers)
        html = urllib.request.urlopen(req)
        soup = BeautifulSoup(html, "html.parser")
        headings = soup.find_all("h2")
        
        count = 0
        for h in headings:
            title_text = h.text.replace("[編集]", "").strip()
            if title_text:
                # 簡易的な重複チェック（同じカテゴリに同じタイトルがなければ追加）
                cursor.execute(
                    "SELECT id FROM scraped_data WHERE category = ? AND title = ?", 
                    (category, title_text)
                )
                if not cursor.fetchone():
                    cursor.execute("INSERT INTO scraped_data (category, title) VALUES (?, ?)", (category, title_text))
                    count += 1
                    total_saved += 1
                    
        conn.commit()
        print(f"   -> {category}: 新規 {count} 件のデータを追加しました。")
    except Exception as e:
        print(f"   ⚠️ エラー ({category}): {e}")

# データベースから全データを取得して最新の構造化マップを作る
cursor.execute("SELECT category, title FROM scraped_data")
rows = cursor.fetchall()
conn.close()

# データをカテゴリごとに辞書化
categorized_data = {}
for cat, title in rows:
    if cat not in categorized_data:
        categorized_data[cat] = []
    if title not in categorized_data[cat]:
        categorized_data[cat].append(title)

# 3. 高度で洗練されたデザインのHTMLを自動生成（CSSにこだわり、AIフレンドリーな構造化）
