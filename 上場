"""

for cat, titles in categorized_data.items():
    html_output += f'        <section class="category-section">\n'
    html_output += f'            <h2>📂 {cat}</h2>\n'
    html_output += f'            <ul>\n'
    for t in titles:
        html_output += f'                <li>{t}</li>\n'
    html_output += f'            </ul>\n'
    html_output += f'        </section>\n'

html_output += """
    </main>

    <footer>
        <p>🚀 Powered by Python, SQLite & GitHub Actions | Designed for AI-driven Knowledge Navigation</p>
